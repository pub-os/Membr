{
  "name": "membr.web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "api:schema": "curl -s http://localhost:5219/openapi/v1.json -o openapi/schema.json",
    "api:types": "openapi-typescript openapi/schema.json -o src/app/api/schema.d.ts",
    "api:generate": "npm run api:schema && npm run api:types"
  },
  "private": true,
  "packageManager": "npm@11.9.0",
  "dependencies": {
    "@angular/animations": "^21.2.22",
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.2.0",
    "@angular/compiler": "^21.2.0",
    "@angular/core": "^21.2.0",
    "@angular/forms": "^21.2.0",
    "@angular/platform-browser": "^21.2.0",
    "@angular/router": "^21.2.0",
    "@ng-icons/core": "^35.0.1",
    "@ng-icons/lucide": "^35.0.1",
    "@swimlane/ngx-charts": "^25.0.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "rxjs": "~7.8.0",
    "tailwind-merge": "^3.6.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^21.2.21",
    "@angular/build": "^21.2.21",
